# Turso (Produktion auf Vercel)
# 1. Account erstellen: https://turso.tech
# 2. DB erstellen: turso db create buildframeos
# 3. URL holen:     turso db show buildframeos --url
# 4. Token holen:   turso db tokens create buildframeos
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=your-token-here

# Lokal (automatisch, kein Eintrag nötig)
# DATABASE_URL=file:./data/buildframeos.db
